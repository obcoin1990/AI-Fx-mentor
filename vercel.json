{
  "projectSettings": {
    "installCommand": "npm ci",
    "buildCommand": "npm run build",
    "outputDirectory": ".next"
  },
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.aichartmentor.com"
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "destination": "https://api.aichartmentor.com/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      }
    }
  ],
  "regions": ["iad1", "sfo1"]
}

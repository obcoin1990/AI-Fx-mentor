# AI Chart Mentor - Environment Configuration

# Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Database (PostgreSQL/Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/ai_chart_mentor
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=xxxxx_supabase_key_xxxxx

# Cache (Redis)
REDIS_URL=redis://localhost:6379/0

# Deployment
VERCEL_ORG_ID=team_xxxxx
VERCEL_PROJECT_ID=prj_xxxxx
RAILWAY_API_TOKEN=railway_token_xxxxx

# Monitoring
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Backend
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
DEBUG=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=AI Chart Mentor
